{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RecordingGrpcService": {
    "Address": ""
  },
  "Azure": {
    "StorageConnectionString": ""
  },
  "RabbitMQ": {
    "Host": "",
    "Port": "5671",
    "VirtualHost": "",
    "Username": "",
    "Password": ""
  },
  "Otlp": {
    "Endpoint": "",
    "Protocol": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  }
}
